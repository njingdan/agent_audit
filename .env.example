# Committed placeholder template. Copy to .env.local and never commit real credentials.
# Required by all four AgentRun runtimes.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LOG_LEVEL=INFO

# Optional: used only by scripts/Build-Images.ps1 for local fallback builds.
AGENTRUN_IMAGE_REPOSITORY=your-acr-host/your-namespace/audit
AGENTRUN_IMAGE_TAG=1.0.0

# Required for AgentRun deployment: four independently versioned ACR images.
AGENTRUN_POLICY_IMAGE=your-acr-host/your-namespace/audit:policy-1.0.0
AGENTRUN_RESEARCH_IMAGE=your-acr-host/your-namespace/audit:research-1.0.0
AGENTRUN_PROVIDER_IMAGE=your-acr-host/your-namespace/audit:provider-1.0.0
AGENTRUN_CONCIERGE_IMAGE=your-acr-host/your-namespace/audit:concierge-1.0.1
AGENTRUN_REGION=cn-hangzhou

# Obtain from the ARMS Python application access page.
ARMS_LICENSE_KEY=

# Set after the corresponding AgentRuntime endpoints are ACTIVE.
# Use the AgentRun A2A base URL ending in /invocations; do not append the card path.
POLICY_A2A_URL=
RESEARCH_A2A_URL=
PROVIDER_A2A_URL=
CONCIERGE_A2A_URL=

# Tolerate AgentRun scale-to-zero cold starts while loading downstream cards.
A2A_DISCOVERY_TIMEOUT_SECONDS=45
A2A_DISCOVERY_MAX_ATTEMPTS=3
A2A_DISCOVERY_BACKOFF_SECONDS=2

# Required only by scripts/Export-Traces.ps1. Prefer a read-only RAM user/role.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
