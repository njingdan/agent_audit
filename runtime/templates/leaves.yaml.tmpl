apiVersion: agentrun/v1
kind: AgentRuntime
metadata:
  name: a2a-policy-agent
  description: Insurance policy A2A agent with ARMS tracing
spec:
  container:
    image: __POLICY_IMAGE__
    imageRegistryType: ACR
    port: 9000
  cpu: 2
  memory: 4096
  port: 9000
  protocol:
    type: HTTP
    settings:
      - type: A2A
        name: a2a-jsonrpc
        path: /
        method: POST
        requestContentType: application/json
        responseContentType: application/json
        a2aAgentCardUrl: /.well-known/agent-card.json
  network:
    mode: PUBLIC
  healthCheck:
    httpGetUrl: /healthz
    initialDelaySeconds: 20
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
    successThreshold: 1
  env:
    AGENT_NAME: policy
    AGENT_BIND_HOST: 0.0.0.0
    AGENT_PORT: "9000"
    LOG_LEVEL: INFO
    DEEPSEEK_API_KEY: __DEEPSEEK_API_KEY__
    DEEPSEEK_BASE_URL: __DEEPSEEK_BASE_URL__
    ARMS_APP_NAME: a2a-policy-agent
    ARMS_REGION_ID: __REGION__
    ARMS_LICENSE_KEY: __ARMS_LICENSE_KEY__
  endpoints:
    - name: default
      description: Policy A2A production endpoint
      targetVersion: LATEST
      disablePublicNetworkAccess: false
---
